          "_name": "content1",
          "_customHTML": "<section class=\"mbr-section article content1\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text col-12 col-md-8 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article><a href=\"https://www.wolfsgeist.ch\" target=\"_blank\" class=\"text-danger text-primary\"></a><a href=\"https://www.wolfsgeist.ch\" class=\"text-danger\" target=\"_blank\"><b>Patricia Wegmann&nbsp;- Wolfsgeist</b></a><div><a href=\"https://www.wolfsgeist.ch\" target=\"_blank\" class=\"text-danger\">Beratungen rund ums Pferd sowie Ausbildung und Weiterbildung von Pferd und Mensch</a></div><div><a href=\"https://www.wolfsgeist.ch\" target=\"_blank\" class=\"text-danger\">Verhaltenstherapie, Lernpsychologie, Boden- und Longenarbeit, Reitunterricht, Tierkommunikation, Therapeutische Arbeit</a></div><div><a href=\"https://www.wolfsgeist.ch\" target=\"_blank\">Ein absolut empfehlenswertes Gesamtpaket!</a></div></div>\n        </div>\n    </div>\n</section>",
