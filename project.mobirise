          "_name": "content1",
          "_sourceTheme": "mobirise4",
          "_customHTML": "<section class=\"mbr-section article content1\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text col-12 col-md-8 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article><p>|<a href=\"https://blog.pferdephysio-bodensee.com/ohne-pferd-kein-huf/\" class=\"text-danger\" target=\"_blank\"><u>Hier geht es zum Blog \"Ohne Pferd kein Huf\"</u></a></p><p>und</p><p>|<a href=\"https://blog.pferdephysio-bodensee.com/dicke-sehne-lahmes-pferd/\" class=\"text-danger\" target=\"_blank\"><u>Hier geht es zum Blog \"Dicke Sehne - lahmes Pferd\"</u></a></p></div>\n        </div>\n    </div>\n</section>",
          "_anchor": "content1-fh",
          "_isUserblock": true,
          "_cid": "vd09xgT7jV",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
