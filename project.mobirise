          "_name": "content1",
          "_customHTML": "<section class=\"mbr-section article content1\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Oben\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Unten\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Width Content\" name=\"widthContent\" min=\"1\" max=\"4\" step=\"1\" value=\"2\">\n        <input type=\"color\" title=\"Hintergrundfarbe\" name=\"bgColor\" value=\"#fffaf5\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text col-12 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article mbr-class=\"{'col-md-6': widthContent == 1, 'col-md-8': widthContent == 2, 'col-md-10': widthContent == 3, 'col-md-12': widthContent == 4}\"><p><b><a href=\"https://www.pias-pfotenschule.ch\" target=\"_blank\" class=\"text-danger\"><b>Pia's Pfotenschule</b></a></b><a href=\"https://www.pias-pfotenschule.ch\" target=\"_blank\" class=\"text-danger\"><br>DIE Familien- und Trickhundeschule im Thurgau. Mit großer Leidenschaft, liebevoller Konsequenz sowie immensem Wissen rund um den Hund und sein Lernverhalten.&nbsp;</a></p></div>\n        </div>\n    </div>\n</section>",
          "_cid": "sddsUTs059",
