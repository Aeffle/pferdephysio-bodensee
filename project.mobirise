          "_name": "content1",
          "_sourceTheme": "mobirise4",
          "_customHTML": "<section class=\"mbr-section article content1\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text col-12 col-md-8 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article>Quellen:<div><span style=\"font-size: 1rem;\">Pulsierende Magnetfeld-Therapie bei Pferden und Kleintieren, Dr. med. vet. Waltraud Schott</span></div><div><span style=\"font-size: 1rem;\">www.equimag.de</span></div><div><span style=\"font-size: 1rem;\">Physikalische Therapien, Equine Care, Dr. rer. nat. J. H. Rudolph<br></span><br></div></div>\n        </div>\n    </div>\n</section>",
          "_anchor": "content1-78",
