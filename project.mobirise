          "_name": "content8",
          "_sourceTheme": "mobirise4",
          "_customHTML": "<section class=\"mbr-section content8\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline=\"\" title=\"Oben\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline=\"\" title=\"Unten\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"color\" title=\"Hintergrundfarbe\" name=\"bgColor\" value=\"#fffaf5\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"media-container-row title\">\n            <div class=\"col-12 col-md-8\">\n                <div class=\"mbr-section-btn align-center\" mbr-buttons=\"\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-danger-outline\" href=\"https://f2fb576b.sibforms.com/serve/MUIFAKV3tBCewdYVbd-mUCngIUAx1FL-j62GBK1ZwRlO2kGHHGH82kKNhsxzr5HAcB94tgsluaLs2e6r1cFAxzU9ntjRaJY9LRaz_EvVXHVcLPefJAhttGgAbrn6wT1v5HPgO0SeXkZ1QPUPDiuS7AjbNbSfuTMx9gckfoCDmo3BCuH6Na7G8vxNcP1Bm_db73Pzk8X_QRP7zTySdA==\" data-app-placeholder=\"Type Text\" target=\"_blank\">auf die Warteliste</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
