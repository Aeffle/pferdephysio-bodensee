          "_name": "content1",
          "_customHTML": "<section class=\"mbr-section article content1\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#fffaf5\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text col-12 col-md-8 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article><p><span style=\"font-size: 1rem;\"><b>Dienstleistungen</b><br>Die Preise für die einzelnen Angebote entnimmst du bitte der Beschreibung der <a href=\"page19.html\" class=\"text-danger\"><u style>Dienstleistungen</u></a>.</span></p><p><span style=\"font-size: 1rem;\"><br></span></p><p><span style=\"font-size: 1rem;\"><b>Anfahrtskosten<br></b></span><span style=\"font-size: 1rem;\">Diese berechnen sich ab 8253 Diessenhofen, TG.&nbsp;</span></p><p><span style=\"font-size: 1rem;\">Bis 10 km Anfahrt sind die Anfahrtskosten mit inbegriffen.<br>10-19 km: CHF 10,-<br>20-29 km: CHF 20,-&nbsp;<br>30-39 km: CHF 30,-<br>40-49 km: CHF 40,-<br></span></p><p><span style=\"font-size: 1rem;\">Bei mehreren Pferden an einem Stall werden die Anfahrtskosten aufgeteilt.</span></p><p>Natürlich bin ich bemüht meine Routenplanung so zu optimieren, dass eine Reduktion der Fahrtkosten möglich ist.</p><p></p></div>\n        </div>\n    </div>\n</section>",
          "_cid": "qFNPTUszeK",
          "_anchor": "content1-36",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
