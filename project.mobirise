          "_name": "content1",
          "_sourceTheme": "mobirise4",
          "_customHTML": "<section class=\"mbr-section article content1\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text col-12 col-md-8 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline=\"\" mbr-article=\"\"><p>|<u><a href=\"https://blog.pferdephysio-bodensee.com/ohne-pferd-kein-huf/\" class=\"text-danger\" target=\"_blank\"></a><a href=\"https://blog.pferdephysio-bodensee.com/pferdephysiotherapie/\" class=\"text-danger\" target=\"_blank\">Hier geht es zum Blog \"Papa, was ist Pferdefüßetherapie?\"</a></u></p></div>\n        </div>\n    </div>\n</section>",
