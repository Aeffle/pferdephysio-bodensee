          "_name": "content1",
          "_customHTML": "<section class=\"mbr-section article content1\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#fffaf5\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text col-12 col-md-8 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article><p><b><span style=\"font-size: 1rem; background-color: rgb(255, 250, 245);\"><a href=\"https://www.pferdegesundheitschweiz.ch\" class=\"text-danger\" target=\"_blank\"><b>Michaela von Zerssen</b> <b>-&nbsp;Diätetik und Phytotherapie</b></a></span><span style=\"font-size: 1rem;\"><br></span></b><a href=\"https://www.pferdegesundheitschweiz.ch\" target=\"_blank\" class=\"text-danger\" style=\"font-size: 1rem; background-color: rgb(255, 250, 245);\">PferdeGesundheitSchweiz – Alles für eine gesunde Pferdefütterung von Kräutern bis Zusatzfutter</a><br><a href=\"https://www.pferdegesundheitschweiz.ch\" target=\"_blank\" class=\"text-danger\" style=\"font-size: 1rem; background-color: rgb(255, 250, 245);\">Kompetente Beratung bei Fütterungs- und Gesundheitsfragen</a></p><p></p></div>\n        </div>\n    </div>\n</section>",
